# ─── Front-end IPAN STORE ───────────────────────────────────────────────────
# Salin menjadi ".env". File ".env" JANGAN di-commit (sudah ada di .gitignore).

# CARA B (disarankan): URL BACKEND server Anda sendiri (SSH Tailscale) yang
# memegang API Key & Secret payment gateway dengan aman. Front-end memanggil ini,
# TANPA credential apa pun. Contoh:
#   VITE_BACKEND_URL=http://ipan-vps:3001
#   VITE_BACKEND_URL=https://ipan-vps.tailxxxx.ts.net
VITE_BACKEND_URL=

# Secret untuk memanggil endpoint admin di backend (mis. kirim ulang email lisensi).
# HARUS sama persis dengan ADMIN_API_SECRET di server/.env.
# Generate: openssl rand -hex 32
VITE_ADMIN_API_SECRET=

# Supabase (frontend anon) — untuk login admin & data publik.
# Dari Dashboard Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
