# ─── Front-end IPAN STORE ───────────────────────────────────────────────────
# Salin menjadi ".env". File ".env" JANGAN di-commit (sudah ada di .gitignore).

# CARA B (disarankan): URL BACKEND server Anda sendiri (SSH Tailscale) yang
# memegang API key Cashi dengan aman. Front-end memanggil ini, TANPA API key.
# Contoh:
#   VITE_BACKEND_URL=http://ipan-vps:3001
#   VITE_BACKEND_URL=https://ipan-vps.tailxxxx.ts.net
VITE_BACKEND_URL=

# ─── Opsi lain (tidak wajib bila CARA B dipakai) ────────────────────────────

# Base URL API Cashi langsung — hanya untuk testing lokal.
VITE_CASHI_BASE_URL=https://cashi.id

# API Key Cashi langsung di front-end — JANGAN untuk produksi (key terekspos
# ke browser). Hanya untuk testing lokal. Produksi: pakai VITE_BACKEND_URL.
VITE_CASHI_API_KEY=
