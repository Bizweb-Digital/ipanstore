# ─── Backend IPAN STORE (server sendiri via SSH Tailscale) ──────────────────
# Salin file ini menjadi ".env" di folder server/ lalu isi nilainya.
# File ".env" JANGAN di-commit (sudah ada di .gitignore).

# Port backend (bebas, mis. 3001)
PORT=3001

# Domain front-end Anda yang boleh memanggil backend (CORS).
# Pisahkan dengan koma bila lebih dari satu. Contoh:
#   ALLOWED_ORIGINS=https://ipanstore.my.id,https://www.ipanstore.my.id,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# ─── DOKU (Payment Gateway utama) ───────────────────────────────────────────
# Dari Dashboard DOKU → Integrations → API Keys
DOKU_CLIENT_ID=MCH-0001-xxxxxxxxxxxxxxxx
DOKU_SECRET_KEY=your_secret_key_here

# Base URL API: pilih sandbox (testing) atau production (live)
#   Sandbox:     https://api-sandbox.doku.com  (testing tanpa uang sungguhan)
#   Production:  https://api.doku.com           (live — sudah KYC & akun sebenarnya)
DOKU_BASE_URL=https://api-sandbox.doku.com

# Path endpoint (Request-Target untuk signature) — jangan ganti kecuali DOKU mengubah
DOKU_CHECKOUT_PATH=/checkout/v1/payment

# URL "Back to merchant" setelah pembayaran selesai (opsional).
# Misal: https://ipanstore.my.id/order
DOKU_CALLBACK_URL=https://ipanstore.my.id/order

# ─── Cashi.id (legacy — simpan untuk referensi, tidak dipakai aktif) ─────────
CASHI_API_KEY=
CASHI_WEBHOOK_SECRET=
CASHI_BASE_URL=https://cashi.id
