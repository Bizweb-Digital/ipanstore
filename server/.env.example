# ─── Backend IPAN STORE (server sendiri via SSH Tailscale) ──────────────────
# Salin file ini menjadi ".env" di folder server/ lalu isi nilainya.
# File ".env" JANGAN di-commit (sudah ada di .gitignore).

# Port backend (bebas, mis. 3001)
PORT=3001

# Domain front-end Anda yang boleh memanggil backend (CORS).
# Pisahkan dengan koma bila lebih dari satu. Contoh:
#   ALLOWED_ORIGINS=https://ipanstore.id,https://www.ipanstore.id,http://localhost:8080
ALLOWED_ORIGINS=https://ipanstore.id,https://www.ipanstore.id,http://localhost:8080

# ─── DOKU (Payment Gateway utama) ───────────────────────────────────────────
# Dari Dashboard DOKU → Integrations → API Keys
DOKU_CLIENT_ID=MCH-0001-xxxxxxxxxxxxxxxx
DOKU_SECRET_KEY=your_secret_key_here

# Base URL API: pilih sandbox (testing) atau production (live)
#   Sandbox:     https://api-sandbox.doku.com  (testing tanpa uang sungguhan)
#   Production:  https://api.doku.com           (live — sudah KYC & akun sebenarnya)
DOKU_BASE_URL=https://api-sandbox.doku.com

# Path endpoint (Request-Target untuk signature) — jangan ganti kecuali DOKU mengubah
DOKU_CHECKOUT_PATH=/checkout/v1/payment

# URL "Back to merchant" setelah pembayaran selesai (opsional).
# Misal: https://ipanstore.id/order
DOKU_CALLBACK_URL=https://ipanstore.id/order

# URL webhook (notifikasi status pembayaran dari DOKU → backend kita).
# Dikirim per-transaksi via additional_info.override_notification_url,
# sehingga tidak perlu set manual di Dashboard DOKU.
DOKU_NOTIFICATION_URL=https://api.ipanstore.id/api/doku-webhook

# ─── KlikQris (Payment Gateway QRIS Dinamis — aktif) ─────────────────────────
# Dari dashboard KlikQris: https://klikqris.com → dokumentasi (login) → Kredensial API
KLIKQRIS_API_KEY=your_klikqris_api_key_here
KLIKQRIS_ID_MERCHANT=178785053413
# Base URL API KlikQris (jangan ganti kecuali karena update dari KlikQris)
KLIKQRIS_BASE_URL=https://klikqris.com/api
# URL webhook KlikQris (notifikasi status pembayaran PAID/EXPIRED → backend kita)
KLIKQRIS_CALLBACK_URL=https://api.ipanstore.id/api/klikqris-webhook

# ─── Email otomatis (kirim link produk SettinX + invoice setelah lunas) ──────
# SMTP Gmail: host smtp.gmail.com, port 465 (SSL), user = email Gmail Anda,
# pass = App Password (bukan password biasa). Buat di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=muhammadrizvandysukma@gmail.com
SMTP_PASS=your_16_char_app_password
# Nama pengirim tampilan (opsional)
# MAIL_FROM=IPAN STORE <muhammadrizvandysukma@gmail.com>

# ─── Supabase (Admin Panel) ─────────────────────────────────────────────────
# ⚠️ GANTI DENGAN KREDENSIAL SUPABASE ANDA SETELAH MEMBUAT PROJECT
# URL Supabase project Anda (dari Dashboard Supabase → Project Settings → API)
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
# Service role key (PENTING: jangan expose ke frontend, hanya untuk backend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Link MediaFire produk "Ipan Module SettinX 1.1" (modul, dikirim via email setelah bayar lunas)
SETTINX_MODULE_1_1_DOWNLOAD_URL=https://www.mediafire.com/file/ckyz6vnn9kxga6b/Ipan_Module_SettinX.apk/file

# ─── Firebase SettinX (auto-generate username/password/license utk pembeli) ─
# Project ID Firebase aplikasi Ipan App SettinX V1 (lihat D:\Ipan-AppSettinX-V1\src\ipan_optimizer\app\auth.py)
SETTINX_FIREBASE_PROJECT_ID=ipan-app-settinx
# Path ke file service-account JSON (download dari Firebase Console → Project settings
# → Service accounts → Generate new private key). File ini RAHASIA, jangan di-commit.
# Di server live simpan di path aman mis. /root/ipanstore-secrets/settinx-service-account.json
SETTINX_FIREBASE_SERVICE_ACCOUNT_FILE=/root/ipanstore-secrets/settinx-service-account.json

# ─── Admin API (wajib untuk endpoint sensitif seperti /api/settinx/resend) ────
# Secret acak yang HARUS sama dengan VITE_ADMIN_API_SECRET di frontend (root .env).
# Generate: openssl rand -hex 32
ADMIN_API_SECRET=your_random_admin_api_secret_here

# ─── Notifikasi pasca-lunas (opsional) ───────────────────────────────────────
# Kirim WhatsApp otomatis ke customer setelah order LUNAS via Fonnte (https://fonnte.com).
# Isi "true" untuk mengaktifkan; kosong/nonaktif jika belum punya akun Fonnte.
WA_NOTIFY_ENABLED=false
# Token API Fonnte (dari dashboard Fonnte → API Token)
FONNTE_TOKEN=your_fonnte_token_here
