# ─── Backend IPAN STORE (server sendiri via SSH Tailscale) ──────────────────
# Salin file ini menjadi ".env" di folder server/ lalu isi nilainya.
# File ".env" JANGAN di-commit (sudah ada di .gitignore).

# Port backend (bebas, mis. 3001)
PORT=3001

# Domain front-end Anda yang boleh memanggil backend (CORS).
# Pisahkan dengan koma bila lebih dari satu. Contoh:
#   ALLOWED_ORIGINS=https://ipanstore.id,https://www.ipanstore.id,http://localhost:8080
ALLOWED_ORIGINS=https://ipanstore.id,https://www.ipanstore.id,http://localhost:8080

# ─── DOKU (Payment Gateway utama) ───────────────────────────────────────────
# Dari Dashboard DOKU → Integrations → API Keys
DOKU_CLIENT_ID=MCH-0001-xxxxxxxxxxxxxxxx
DOKU_SECRET_KEY=your_secret_key_here

# Base URL API: pilih sandbox (testing) atau production (live)
#   Sandbox:     https://api-sandbox.doku.com  (testing tanpa uang sungguhan)
#   Production:  https://api.doku.com           (live — sudah KYC & akun sebenarnya)
DOKU_BASE_URL=https://api-sandbox.doku.com

# Path endpoint (Request-Target untuk signature) — jangan ganti kecuali DOKU mengubah
DOKU_CHECKOUT_PATH=/checkout/v1/payment

# URL "Back to merchant" setelah pembayaran selesai (opsional).
# Misal: https://ipanstore.id/order
DOKU_CALLBACK_URL=https://ipanstore.id/order

# URL webhook (notifikasi status pembayaran dari DOKU → backend kita).
# Dikirim per-transaksi via additional_info.override_notification_url,
# sehingga tidak perlu set manual di Dashboard DOKU.
DOKU_NOTIFICATION_URL=https://api.ipanstore.id/api/doku-webhook

# ─── Email otomatis (kirim link produk SettinX + invoice setelah lunas) ──────
# SMTP Gmail: host smtp.gmail.com, port 465 (SSL), user = email Gmail Anda,
# pass = App Password (bukan password biasa). Buat di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=muhammadrizvandysukma@gmail.com
SMTP_PASS=your_16_char_app_password
# Nama pengirim tampilan (opsional)
# MAIL_FROM=IPAN STORE <muhammadrizvandysukma@gmail.com>

# Link Google Drive produk IPAN APP SettinX V1 (folder .exe + tutorial)
SETTINX_DOWNLOAD_URL=https://drive.google.com/drive/folders/1oB2BIILhM-xrgseTw7yYSYwxurLayTvq?usp=sharing

# ─── Cashi.id (legacy — simpan untuk referensi, tidak dipakai aktif) ─────────
CASHI_API_KEY=
CASHI_WEBHOOK_SECRET=
CASHI_BASE_URL=https://cashi.id
